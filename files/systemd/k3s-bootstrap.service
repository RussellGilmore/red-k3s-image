[Unit]
Description=First-boot bootstrap for the red-k3s single-node cluster
After=network-online.target cloud-final.service
Wants=network-online.target
# Skip entirely once the bootstrap has completed successfully.
ConditionPathExists=!/var/lib/k3s-bootstrap/.complete

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/bin/k3s-bootstrap
StandardOutput=journal+console
StandardError=journal+console
# Cert issuance alone can take several minutes; give the whole run room.
TimeoutStartSec=1200

[Install]
WantedBy=multi-user.target
