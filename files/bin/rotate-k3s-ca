#!/usr/bin/env bash
#
# rotate-k3s-ca — replace K3s server CA with the Let's Encrypt certificate
# stored in the cert-manager-issued secret `k3s-api-cert-tls`.
#
# This script is idempotent: if the on-disk K3s CA already matches the
# certificate in the secret, it exits successfully without rotating.
#
# Invoked at:
#   - First boot, after cert-manager issues the initial cert
#   - Every cert-manager renewal, via the on-cert-renewal hook
#
set -euo pipefail

SECRET_NS="${SECRET_NS:-cert-manager}"
SECRET_NAME="${SECRET_NAME:-k3s-api-cert-tls}"
K3S_TLS_DIR="/var/lib/rancher/k3s/server/tls"
STAGING_DIR="/tmp/k3s-new-ca-$$"

log() { echo "[$(date -u +%FT%TZ)] $*"; }

require_root() {
  if [[ "${EUID}" -ne 0 ]]; then
    echo "ERROR: must run as root" >&2
    exit 1
  fi
}

require_root

log "Extracting cert from secret ${SECRET_NS}/${SECRET_NAME}..."
mkdir -p "${STAGING_DIR}"
trap 'rm -rf "${STAGING_DIR}"' EXIT

# Pull the cert and key from the cert-manager-managed secret.
kubectl get secret -n "${SECRET_NS}" "${SECRET_NAME}" \
  -o jsonpath='{.data.tls\.crt}' | base64 -d > "${STAGING_DIR}/server-ca.crt"
kubectl get secret -n "${SECRET_NS}" "${SECRET_NAME}" \
  -o jsonpath='{.data.tls\.key}' | base64 -d > "${STAGING_DIR}/server-ca.key"

# Idempotency: if the on-disk CA already matches what's in the secret,
# rotation has already happened and we're done.
if [[ -f "${K3S_TLS_DIR}/server-ca.crt" ]] && \
   cmp -s "${STAGING_DIR}/server-ca.crt" "${K3S_TLS_DIR}/server-ca.crt"; then
  log "On-disk K3s CA already matches secret. No rotation needed."
  exit 0
fi

log "Backing up existing K3s CA to ${K3S_TLS_DIR}/*.bak-$(date -u +%Y%m%d-%H%M%S)..."
TIMESTAMP="$(date -u +%Y%m%d-%H%M%S)"
cp "${K3S_TLS_DIR}/server-ca.crt" "${K3S_TLS_DIR}/server-ca.crt.bak-${TIMESTAMP}"
cp "${K3S_TLS_DIR}/server-ca.key" "${K3S_TLS_DIR}/server-ca.key.bak-${TIMESTAMP}"

log "Rotating K3s CA via 'k3s certificate rotate-ca'..."
k3s certificate rotate-ca --path="${STAGING_DIR}"

log "Restarting k3s.service to pick up new CA..."
systemctl restart k3s.service

log "Waiting for k3s API server to come back online..."
for i in {1..60}; do
  if kubectl --request-timeout=5s get --raw=/readyz >/dev/null 2>&1; then
    log "k3s API server is responding."
    exit 0
  fi
  sleep 5
done

log "ERROR: k3s API server did not come back online within 5 minutes."
exit 1
