# Rendered to /etc/rancher/k3s/config.yaml by red-k3s-first-boot.sh.
# __DOMAIN__ is replaced with the cluster's FQDN at first boot.

write-kubeconfig-mode: "0600"

# Embedded etcd from the start so additional servers can join later
# without a datastore migration.
cluster-init: true

tls-san:
  - __DOMAIN__
