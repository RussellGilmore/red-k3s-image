---
apiVersion: cert-manager.io/v1
kind: Certificate
metadata:
  name: k3s-api-cert
  namespace: cert-manager
spec:
  secretName: k3s-api-cert-tls
  duration: 1440h   # 60 days
  renewBefore: 360h # 15 days before expiry, so renewal runs every ~45 days
  isCA: false
  privateKey:
    algorithm: RSA
    encoding: PKCS1
    size: 2048
  dnsNames:
    - {{DOMAIN}}
  issuerRef:
    name: letsencrypt-{{LE_ENV}}
    kind: ClusterIssuer
    group: cert-manager.io
